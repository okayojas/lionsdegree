{
  "name": "lionsdegree-mcp",
  "version": "0.1.0",
  "description": "Ask your own AI about your Penn State degree. Reads a LionsDegree plan file locally; no account, no API key, no network.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "lionsdegree-mcp": "./dist/server.js" },
  "files": ["dist", "catalog"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-catalog": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@psu-planner/engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
