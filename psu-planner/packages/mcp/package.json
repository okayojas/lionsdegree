{
  "name": "lionsdegree-mcp",
  "version": "0.1.0",
  "description": "Ask your own AI about your Penn State degree. Reads a LionsDegree plan file locally; no account, no API key, no network.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "lionsdegree-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "catalog"
  ],
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --external:@modelcontextprotocol/sdk --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "prepublishOnly": "npm run sync-catalog && npm run build",
    "measure-memory": "npx tsx --expose-gc scripts/measure-memory.mts",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "worker:deploy": "npm run sync-catalog && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@psu-planner/engine": "workspace:*",
    "@psu-planner/identity": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.110.0"
  }
}
