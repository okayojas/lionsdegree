# Chat proxy configuration. Copy to `.env` and fill in what you need.
# The proxy is OPTIONAL — the planner works fully without it; only the AI
# advisor needs it. Nothing here is required to run `pnpm --filter web dev`.

# ---- Required to run the proxy at all -------------------------------------
# Any OpenAI-compatible key. Never commit the filled-in file; `.env` is ignored.
OPENAI_API_KEY=

# ---- Model and budget (optional, sensible defaults in app.ts) --------------
# Default: gpt-5-mini
OPENAI_MODEL=
# OpenAI project id (proj_...). The monthly spend cap is set PER PROJECT, so
# usage must be attributed to the capped project or the cap never binds.
OPENAI_PROJECT=
# Total completion budget, reasoning + output. Default: 8000.
# Reasoning tokens count against this. Too low and the model can spend the whole
# budget thinking and return nothing — see DECISIONS.md 4.2.
OPENAI_MAX_TOKENS=
# none | minimal | low | medium | high. Default: minimal.
# A tool-driven advising chat wants the low end; the engine does the reasoning.
OPENAI_REASONING_EFFORT=

# ---- Access control -------------------------------------------------------
# Comma-separated origins allowed to call the API in production. With this unset
# in production, cross-origin browser calls are blocked.
ALLOWED_ORIGINS=
# "development" relaxes CORS to localhost. Anything else is treated as production.
NODE_ENV=development
# Requests allowed per identity per day. Default: 50.
FREE_DAILY_LIMIT=
# Supabase project JWT secret (HS256). When set, a valid Bearer token identifies
# the user and rate limiting keys on their `sub` instead of their IP.
SUPABASE_JWT_SECRET=
# When truthy, requests WITHOUT a verified identity are rejected (fail closed).
# Leave unset unless SUPABASE_JWT_SECRET is also set, or nobody can use the chat.
REQUIRE_AUTH=
