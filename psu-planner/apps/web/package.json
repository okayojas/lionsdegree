{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync-catalog": "node scripts/sync-catalog.mjs",
    "deploy": "npm run sync-catalog && npm run build && npm run og && wrangler pages deploy dist --project-name lionsdegree",
    "test": "vitest run",
    "test:build": "npm run build && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "og": "node scripts/make-og.mjs",
    "deploy:self-host": "node -e \"if(!process.env.VITE_CHAT_ENDPOINT){console.error('set VITE_CHAT_ENDPOINT=/v1/chat first');process.exit(1)}\" && npm run sync-catalog && npm run build && npm run og && node scripts/deploy-self-host.mjs"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@psu-planner/engine": "workspace:*",
    "@supabase/supabase-js": "^2.110.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "hono": "^4.6.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.110.0"
  }
}
