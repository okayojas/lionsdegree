 {
  "code": "FOR 517",
  "subject": "FOR",
  "number": "517",
  "display": "FOR 517",
  "title": "Ecology of Plant Roots",
  "credits": "2 Credits",
  "creditsParsed": {
   "min": 2,
   "max": 2,
   "repeatableMax": null
  },
  "description": "This course covers the form and function of roots from an ecological perspective. Emphasis is placed on identifying and interpreting the diversity of root strategies used by plants to meet the essential functions of water and nutrient acquisition, transport, storage and structural support under various environmental conditions. Additional topics include how root systems may modify ecosystem processes associated with carbon, mineral nutrient and water cycles. Specialized topics include cost/benefit analysism, root evolution, root architecture, root herbivory-defense, mycorrhizas, root respiration, root longevity, resource competition and interference and weathering and soil formation. Both wild and crop plants are discussed.",
  "enforced": null,
  "concurrent": null,
  "prereqAdvisory": null,
  "prereqAst": null,
  "concurrentAst": null,
  "astComplete": true,
  "genEd": [],
  "attributes": [],
