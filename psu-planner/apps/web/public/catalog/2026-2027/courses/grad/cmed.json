 {
  "code": "CMED 810",
  "subject": "CMED",
  "number": "810",
  "display": "CMED 810",
  "title": "Management of Animal Care and Use Programs in Biomedical Research",
  "credits": "1 Credits",
  "creditsParsed": {
   "min": 1,
   "max": 1,
   "repeatableMax": null
  },
  "description": "This course will provide opportunities for students to apply knowledge and skills needed for administration and management of an animal resources program in biomedical research. Using active learning practices, students will explore topics specific to housing and caring for research animals. Topics include animal facility design, disaster planning, personnel management, waste management, fiscal management, process management concepts (LEAN, Six Sigma, Systems Approaches), and strategic planning.",
