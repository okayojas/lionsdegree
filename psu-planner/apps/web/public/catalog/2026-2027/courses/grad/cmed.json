 {
  "code": "CMED 801",
  "subject": "CMED",
  "number": "801",
  "display": "CMED 801",
  "title": "Foundations in Laboratory Animal Welfare Laws, Regulations, and Guidelines I",
  "credits": "1 Credits",
  "creditsParsed": {
   "min": 1,
   "max": 1,
   "repeatableMax": null
  },
  "description": "This course uses a problem-based learning approach to develop the ability to interpret and apply laws and regulations that pertain to the humane care and use of laboratory animals. In particular, students will learn how to critically evaluate an Institutional Animal Care and Use Committee (IACUC) protocol for compliance with laws, regulations, guidelines and position statements that pertain to laboratory animal care and use. Licensed veterinarians enrolled in the Laboratory Animal Medicine Master's degree training program are the target audience",
  "enforced": null,
  "concurrent": null,
  "prereqAdvisory": null,
  "prereqAst": null,
  "concurrentAst": null,
  "astComplete": true,
  "genEd": [],
  "attributes": [],
  "crossListings": [],
  "aliases": [
   "CMED 801"
  ],
  "level": "graduate",
  "url": "https://bulletins.psu.edu/university-course-descriptions/graduate/cmed/",
  "extraRaw": [
   "Recommended Preparation: Previous experience in basic science research using animals, and/or familiarity with regulations that govern animal care and use would provide good preparation for this course."
  ],
