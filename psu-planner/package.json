{
  "name": "psu-planner",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=9"
  },
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "sync-catalog": "pnpm --filter web sync-catalog",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "audit:ci": "pnpm audit --prod --audit-level=high",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:e2e:install": "pnpm --filter web test:e2e:install"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "//": "S7: force patched transitive build-tooling deps flagged by pnpm audit. Run `pnpm install` to apply, then `pnpm audit`.",
    "overrides": {
      "postcss": "^8.5.18",
      "fast-uri": "^3.1.4",
      "brace-expansion": "^5.0.8",
      "sharp": "^0.35.0"
    }
  }
}
